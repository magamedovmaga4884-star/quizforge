# QuizForge Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/quizforge

# Security
SECRET_KEY=quizforge-production-super-secret-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local AI (Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
